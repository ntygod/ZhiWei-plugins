{
  "pluginId": "feishu",
  "name": "飞书",
  "version": "1.0.0",
  "vendor": "zhiwei",
  "platform": "feishu",
  "connectorMode": "EXTERNAL",
  "connectorSpec": {
    "protocol": "http",
    "pathPrefix": "/instances/{instanceId}",
    "image": "ghcr.io/zhiwei/connectors/feishu:1.0.0",
    "managed": {
      "strategy": "installed-jar",
      "artifactPath": "dist/feishu-connector.jar",
      "workspace": "connectors/feishu-connector",
      "healthPath": "/actuator/health",
      "preferredPort": 19091
    }
  },
  "capabilities": [
    "receive",
    "send",
    "thread-reply",
    "card-update",
    "card-action",
    "image",
    "file"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "title": "Connector Base URL",
        "description": "可选。填写后将优先连接自建飞书 connector；留空时由知微主服务优先尝试自动托管官方 connector。"
      },
      "appId": {
        "type": "string",
        "title": "App ID"
      },
      "appSecret": {
        "type": "string",
        "title": "App Secret",
        "secret": true
      },
      "connectionMode": {
        "type": "string",
        "title": "接入模式",
        "enum": [
          "websocket",
          "webhook"
        ],
        "default": "websocket"
      },
      "verificationToken": {
        "type": "string",
        "title": "Verification Token"
      },
      "encryptKey": {
        "type": "string",
        "title": "Encrypt Key",
        "secret": true
      }
    },
    "required": [
      "appId",
      "appSecret"
    ]
  },
  "secretFields": [
    "appSecret",
    "encryptKey"
  ],
  "resources": {
    "readmePath": "docs/README.md",
    "iconPath": "assets/icon.svg",
    "examplePaths": [
      "examples/websocket.json",
      "examples/webhook.json"
    ],
    "assetPaths": [
      "dist/feishu-connector.jar"
    ]
  },
  "setupGuide": {
    "title": "飞书 Connector 插件",
    "steps": [
      "默认只需要填写 App ID 和 App Secret；安装包已包含官方 connector 运行时，主服务会优先自动托管。",
      "如果你要连接自建 connector，可额外填写 Connector Base URL 覆盖默认托管。",
      "推荐优先使用 websocket；如果需要公网回调，可切换为 webhook 并补齐 Verification Token 与 Encrypt Key。"
    ]
  }
}
